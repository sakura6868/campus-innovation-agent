# 复制为 .env 后按需修改。默认配置可完全离线运行。
DATABASE_URL=sqlite:////app/data/campus_agent.db
RAG_USE_ST=0

# 必填：保护 /api/admin/* 数据维护接口。请使用随机长令牌，不要提交真实值。
ADMIN_API_TOKEN=replace-with-a-random-secret

# 建议部署时配置：用于签发短期用户会话；未配置时每次进程启动自动生成随机密钥。
AUTH_TOKEN_SECRET=replace-with-an-independent-random-secret
AUTH_TOKEN_TTL_SECONDS=28800

# 可选：启用 OpenAI 兼容模型润色。留空时使用确定性模板。
# AGENT_LLM_BASE_URL 可指向任意 OpenAI 兼容端点（如 DeepSeek / 通义 / 智谱 / 本地 vLLM）。
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
AGENT_LLM_TEMPERATURE=0.3
AGENT_LLM_PROVIDER=

# 可选：连接远程 Chroma；留空时使用本地隔离检索。
CHROMA_HOST=
CHROMA_PORT=8000

# 联网搜索补充层（可选）：duckduckgo（免 key）/ tavily / serper
# duckduckgo 无需 key，适合演示；tavily/serper 需填入对应 API key
# WEB_SEARCH_PROVIDER=duckduckgo
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_MAX_RESULTS=5
