    {
      "id": "LIVE-03",
      "question": "MathorCup大数据今年怎么报名？",
      "response": {
        "run_id": "agent_f2b437afe4cb4ba4858f5082d5c8d952",
        "question": "MathorCup大数据今年怎么报名？",
